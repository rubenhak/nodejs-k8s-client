{
  "name": "k8s-super-client",
  "version": "2.1.5",
  "description": "Kubernetes Client Library",
  "main": "dist/index.js",
  "types": "dist",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "test": "env TS_NODE_COMPILER_OPTIONS='{\"module\": \"commonjs\" }' mocha -r ts-node/register 'test/**/*.ts'",
    "build": "tsc",
    "format": "prettier --write ./src/ ./test/",
    "format-check": "prettier --check ./src/ ./test/",
    "lint": "eslint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://rubenhak@github.com/rubenhak/nodejs-k8s-client.git"
  },
  "author": "Ruben Hakopian",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/rubenhak/nodejs-k8s-client/issues"
  },
  "homepage": "https://github.com/rubenhak/nodejs-k8s-client#readme",
  "dependencies": {
    "@kubernetes/client-node": "^1.4.0",
    "@types/ndjson": "^2.0.4",
    "@types/uuid": "^11.0.0",
    "ajv": "^8.20.0",
    "axios": "^1.18.1",
    "dotenv": "^17.4.2",
    "js-yaml": "^5.2.1",
    "kubernetes-types": "^1.30.0",
    "ndjson": "^2.0.0",
    "the-lodash": "^3.0.3",
    "the-logger": "3.0.2",
    "the-promise": "^3.0.1",
    "uuid": "^14.0.1",
    "request": "^2.88.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@types/request": "^2.48.13",
    "@types/should": "^13.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "mocha": "^11.7.6",
    "prettier": "^3.9.4",
    "should": "^13.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "pnpm": {
